# Public endpoint, NOT a secret. Never put authentication tokens in VITE_ variables.
# n8n must support CORS, server-side validation, rate limiting and idempotency.
# Confirm acceptance with JSON: { "success": true, "requestId": "<same requestId>" }
VITE_CONTACT_WEBHOOK_URL=

# Optional canonical production origin, for example https://your-domain.example
# Leave unset until the real production domain is known; never include a path.
VITE_SITE_URL=
